# Arquivo de exemplo para configuração das variáveis de ambiente.
# No GitHub Actions, cadastre estas chaves em: Settings > Secrets and variables > Actions > New repository secret

# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Credenciais de envio de E-mail via Gmail (SMTP)
# O remetente pode ser sua própria conta Gmail ou uma conta dedicada.
# NOTA: GMAIL_APP_PASSWORD é a 'Senha de App' gerada na Conta Google (Segurança > Verificação em duas etapas > Senhas de app), NÃO a sua senha normal do Google.
GMAIL_SENDER_EMAIL=seu_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# E-mail de destino para recebimento das notificações (padrão do Paulo)
NOTIFICATION_TARGET_EMAIL=pauloitalo061@gmail.com

# Opcional: Provedor alternativo de IA se desejado
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
